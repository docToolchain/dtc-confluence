root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,yml,yaml}]
indent_size = 2

[*.{md,adoc}]
trim_trailing_whitespace = false


# Recorded fixtures and golden files. Their content is a verbatim record of what
# the code produced or of what a server answered, trailing whitespace included.
# Normalising them would falsify the record they exist to keep.
[dtc-confluence-core/src/test/resources/**]
trim_trailing_whitespace = unset
insert_final_newline = unset
