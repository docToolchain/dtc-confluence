         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.doctoolchain</groupId>
  <artifactId>dtc-confluence</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>dtc-confluence</name>
  <description>Confluence support for docs-as-code, extracted from docToolchain</description>
  <url>https://github.com/docToolchain/dtc-confluence</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>dtc-confluence-core</module>
    <module>dtc-confluence-cli</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <sonar.organization>doctoolchain</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.projectKey>docToolchain_dtc-confluence</sonar.projectKey>
    <!-- Built with JDK 25, released for Java 17. -->
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Deliberately the versions docToolchain uses, so that the move stays a
         move. Groovy and Spock are the exception: Groovy 3 cannot compile on
         JDK 25, and Spock has no Groovy 5 build. -->
    <groovy.version>4.0.33</groovy.version>
    <jsoup.version>1.23.2</jsoup.version>
    <httpclient5.version>5.6.4</httpclient5.version>
    <guava.version>33.7.1-jre</guava.version>
    <snakeyaml.version>2.7</snakeyaml.version>
    <!-- Spock caps Groovy at 4.x: there is no Groovy 5 build of spock-core.
         Groovy 5 fails the build outright, see .github/dependabot.yml. -->
    <picocli.version>4.7.7</picocli.version>
    <spock.version>2.4-M6-groovy-4.0</spock.version>
    <junit.version>6.1.3</junit.version>
    <archunit.version>1.5.0</archunit.version>
    <!-- Spock needs these to mock Java classes. It does not need them for Groovy
         classes, which is why they only became necessary once the port started. -->
    <byte-buddy.version>1.18.13</byte-buddy.version>
    <objenesis.version>3.6</objenesis.version>

    <gmavenplus.version>5.1.0</gmavenplus.version>
    <jacoco.version>0.8.15</jacoco.version>
    <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
  </properties>

